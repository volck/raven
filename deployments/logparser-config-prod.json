    "token_url": "https://auth.dev.norsk-tipping.no/auth/realms/vault/protocol/openid-connect/token",
    "client_id": "log-parser",
    "client_secret": "",
    "scopes": ["openid"]
  },
  "state_file": "/var/lib/raven/logparser-offset",
  "debounce_window": "2s"
}
